---
import { profile, skills } from '../data/portfolio';
---

<section id="sobre-mi" aria-labelledby="sobre-mi-titulo" class="section">
  <div data-reveal>
    <p class="eyebrow">01 · Sobre mí</p>
    <h2 id="sobre-mi-titulo" class="section-title">Quién soy</h2>
  </div>

  <div class="mt-8 grid gap-12 lg:grid-cols-5">
    <div class="space-y-4 text-lg leading-relaxed lg:col-span-2" data-reveal>
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="lg:col-span-3" data-reveal>
      <h3 class="font-display text-xl font-semibold text-zinc-900 dark:text-zinc-50">Habilidades y tecnologías</h3>
      <div class="mt-5 grid gap-5 sm:grid-cols-3">
        {
          skills.map((group) => (
            <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
              <h4 class="font-mono text-sm font-semibold text-emerald-700 dark:text-emerald-400">{group.category}</h4>
              <ul class="mt-3 space-y-2 text-sm text-zinc-800 dark:text-zinc-200">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
