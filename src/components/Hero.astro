---
import { profile } from '../data/portfolio';

const initials = profile.name
  .split(' ')
  .map((word) => word[0])
  .join('');
---

<section id="inicio" class="section flex flex-col-reverse items-start gap-10 md:flex-row md:items-center md:justify-between md:py-32">
  <div class="max-w-2xl" data-reveal>
    <p class="eyebrow">Hola, soy</p>
    <h1 class="font-display text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-50">
      {profile.name}
    </h1>
    <p class="mt-3 font-display text-xl font-medium text-emerald-700 sm:text-2xl dark:text-emerald-400">
      {profile.role}
    </p>
    <p class="mt-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
      {profile.tagline}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
      <a href="#contacto" class="btn btn-secondary">Contactarme</a>
    </div>
  </div>

  <!-- Avatar con iniciales. Para usar una foto: guardarla en src/assets y reemplazar este bloque por el componente Image de astro:assets -->
  <div
    role="img"
    aria-label={`Avatar con las iniciales de ${profile.name}`}
    class="flex size-28 shrink-0 items-center justify-center rounded-3xl bg-emerald-700 font-display text-4xl font-bold text-white shadow-lg shadow-emerald-900/20 sm:size-40 sm:text-6xl dark:bg-emerald-400 dark:text-zinc-950"
    data-reveal
  >
    <span aria-hidden="true">{initials}</span>
  </div>
</section>
