---
import { Image } from 'astro:assets';
import photo from '../assets/alvaro-pistelli.webp';
import { profile } from '../data/portfolio';
---

<section id="inicio" class="section flex flex-col-reverse items-start gap-10 md:flex-row md:items-center md:justify-between md:py-32">
  <div class="max-w-2xl" data-reveal>
    <p class="eyebrow">Hola, soy</p>
    <h1 class="font-display text-4xl font-bold tracking-tight text-zinc-900 sm:text-6xl dark:text-zinc-50">
      {profile.name}
    </h1>
    <p class="mt-3 font-display text-xl font-medium text-emerald-700 sm:text-2xl dark:text-emerald-400">
      {profile.role}
    </p>
    <p class="mt-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
      {profile.tagline}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#proyectos" class="btn btn-primary">Ver proyectos</a>
      <a href="#contacto" class="btn btn-secondary">Contactarme</a>
    </div>
  </div>

  <div class="shrink-0" data-reveal>
    <Image
      src={photo}
      alt={`Foto de ${profile.name}`}
      width={224}
      height={224}
      densities={[1, 2]}
      fit="cover"
      position="top"
      loading="eager"
      fetchpriority="high"
      class="size-36 rounded-full object-cover ring-4 ring-emerald-700 ring-offset-4 ring-offset-zinc-50 sm:size-56 dark:ring-emerald-400 dark:ring-offset-zinc-950"
    />
  </div>
</section>
