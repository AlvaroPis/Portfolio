---
import { projects } from '../data/portfolio';
---

<section id="proyectos" aria-labelledby="proyectos-titulo" class="section">
  <div data-reveal>
    <p class="eyebrow">02 · Proyectos</p>
    <h2 id="proyectos-titulo" class="section-title">En qué estuve trabajando</h2>
  </div>

  <ul class="mt-8 grid gap-6 md:grid-cols-2">
    {
      projects.map((project) => (
        <li data-reveal>
          <article class="flex h-full flex-col rounded-xl border border-zinc-200 bg-white p-6 transition-colors hover:border-emerald-700 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-emerald-400">
            <h3 class="font-display text-xl font-semibold text-zinc-900 dark:text-zinc-50">{project.title}</h3>
            <p class="mt-3 leading-relaxed">{project.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tecnologías usadas">
              {project.tech.map((tech) => <li class="tag">{tech}</li>)}
            </ul>
            <div class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-6 text-sm">
              <a href={project.repo} class="link" target="_blank" rel="noopener noreferrer">
                Repositorio<span class="sr-only"> de {project.title} (abre en una pestaña nueva)</span>
              </a>
              {project.demo && (
                <a href={project.demo} class="link" target="_blank" rel="noopener noreferrer">
                  Demo<span class="sr-only"> de {project.title} (abre en una pestaña nueva)</span>
                </a>
              )}
            </div>
          </article>
        </li>
      ))
    }
  </ul>
</section>
