---
import { profile } from '../data/portfolio';

const inputClass =
  'mt-2 block w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-zinc-900 placeholder:text-zinc-500 aria-[invalid=true]:border-red-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-50 dark:placeholder:text-zinc-400 dark:aria-[invalid=true]:border-red-400';
const labelClass = 'block text-sm font-medium text-zinc-900 dark:text-zinc-100';
const errorClass = 'mt-1.5 text-sm text-red-700 dark:text-red-400';
---

<section id="contacto" aria-labelledby="contacto-titulo" class="section">
  <div data-reveal>
    <p class="eyebrow">03 · Contacto</p>
    <h2 id="contacto-titulo" class="section-title">Hablemos</h2>
  </div>

  <div class="mt-8 grid gap-12 lg:grid-cols-5">
    <div class="lg:col-span-2" data-reveal>
      <p class="text-lg leading-relaxed">
        Estoy abierto a oportunidades laborales y a colaborar en proyectos. Escribime por el medio que te quede más
        cómodo.
      </p>
      <ul class="mt-6 space-y-4">
        <li>
          <span class="block font-mono text-sm text-zinc-600 dark:text-zinc-400">Email</span>
          <a href={`mailto:${profile.email}`} class="link break-all">{profile.email}</a>
        </li>
        <li>
          <span class="block font-mono text-sm text-zinc-600 dark:text-zinc-400">GitHub</span>
          <a href={profile.github} class="link break-all" target="_blank" rel="noopener noreferrer">
            {profile.github.replace('https://', '')}
          </a>
        </li>
        {
          profile.linkedin && (
            <li>
              <span class="block font-mono text-sm text-zinc-600 dark:text-zinc-400">LinkedIn</span>
              <a href={profile.linkedin} class="link break-all" target="_blank" rel="noopener noreferrer">
                {profile.linkedin.replace('https://', '').replace('www.', '')}
              </a>
            </li>
          )
        }
      </ul>
    </div>

    <form
      id="contact-form"
      class="rounded-xl border border-zinc-200 bg-white p-6 lg:col-span-3 dark:border-zinc-800 dark:bg-zinc-900"
      data-email={profile.email}
      novalidate
      data-reveal
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nombre" class={labelClass}>Nombre</label>
          <input id="nombre" name="nombre" type="text" autocomplete="name" required minlength="2" class={inputClass} aria-describedby="nombre-error" />
          <p id="nombre-error" class={errorClass} hidden></p>
        </div>
        <div>
          <label for="email" class={labelClass}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={inputClass} aria-describedby="email-error" />
          <p id="email-error" class={errorClass} hidden></p>
        </div>
      </div>
      <div class="mt-5">
        <label for="mensaje" class={labelClass}>Mensaje</label>
        <textarea id="mensaje" name="mensaje" rows="5" required minlength="10" class={inputClass} aria-describedby="mensaje-error"></textarea>
        <p id="mensaje-error" class={errorClass} hidden></p>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary">Enviar mensaje</button>
        <p class="text-sm text-zinc-600 dark:text-zinc-400">Se abre tu cliente de correo con el mensaje listo.</p>
      </div>
      <p id="form-status" class="mt-4 text-sm font-medium text-emerald-700 dark:text-emerald-400" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  type Field = HTMLInputElement | HTMLTextAreaElement;

  const validators: Record<string, (value: string) => string> = {
    nombre: (value) => (value.length < 2 ? 'Ingresá tu nombre (al menos 2 caracteres).' : ''),
    email: (value) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value) ? '' : 'Ingresá un email válido, por ejemplo nombre@dominio.com.'),
    mensaje: (value) => (value.length < 10 ? 'El mensaje tiene que tener al menos 10 caracteres.' : ''),
  };

  const validate = (field: Field) => {
    const message = validators[field.name]?.(field.value.trim()) ?? '';
    const error = document.getElementById(`${field.name}-error`);
    field.setAttribute('aria-invalid', String(Boolean(message)));
    if (error) {
      error.textContent = message;
      error.hidden = !message;
    }
    return !message;
  };

  if (form) {
    const fields = Array.from(form.querySelectorAll<Field>('input, textarea'));

    fields.forEach((field) => {
      field.addEventListener('blur', () => validate(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (status) status.textContent = '';

      const invalid = fields.filter((field) => !validate(field));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      const nombre = String(data.get('nombre')).trim();
      const email = String(data.get('email')).trim();
      const mensaje = String(data.get('mensaje')).trim();
      const subject = encodeURIComponent(`Contacto desde el portfolio: ${nombre}`);
      const body = encodeURIComponent(`${mensaje}\n\n${nombre}\n${email}`);

      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
      if (status) status.textContent = 'Listo: revisá tu cliente de correo para enviar el mensaje.';
    });
  }
</script>
