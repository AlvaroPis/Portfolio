---
import ThemeToggle from './ThemeToggle.astro';
import { navLinks, profile } from '../data/portfolio';

const initials = profile.name
  .split(' ')
  .map((word) => word[0])
  .join('');
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-zinc-50/90 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/90"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
    <a
      href="#inicio"
      class="font-display text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-50"
      aria-label={`${profile.name}, ir al inicio`}
    >
      {initials}<span class="text-emerald-700 dark:text-emerald-400">.</span>
    </a>

    <div class="flex items-center gap-1">
      <nav aria-label="Principal" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-200 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-50"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ThemeToggle />

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menú"
        class="inline-flex size-10 items-center justify-center rounded-lg text-zinc-700 transition-colors hover:bg-zinc-200 md:hidden dark:text-zinc-200 dark:hover:bg-zinc-800"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Principal, versión móvil" class="border-t border-zinc-200 md:hidden dark:border-zinc-800" hidden>
    <ul class="mx-auto max-w-5xl px-5 py-3 sm:px-8">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-lg px-3 py-3 font-medium text-zinc-800 hover:bg-zinc-200 dark:text-zinc-100 dark:hover:bg-zinc-800"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-mobile');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  toggle?.addEventListener('click', () => setOpen(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>
